# =========================================================================
#  CartaViva — Plantilla de Variables de Entorno (.env.example)
#  Copia este archivo como ".env" y pon tus claves reales (NO subas .env a Git)
# =========================================================================

# Base de datos PostgreSQL
DB_USER=cartaviva
DB_PASSWORD=pon_aqui_una_contraseña_segura
DB_NAME=cartaviva_db

# Seguridad API y Autenticación JWT
JWT_SECRET=genera_una_clave_larga_y_aleatoria_aqui
PORT=4000

# Dominio del proyecto (para QR y CORS)
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=https://tudominio.com
